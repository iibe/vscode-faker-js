{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /* Emitter */
    "noEmit": false,
    "emitDeclarationOnly": false,
    "rootDir": "./src",
    "outDir": "./dist",

    /* Emit Modules */
    "module": "node16",
    "moduleResolution": "node16",
    "paths": {},

    /* Emit JavaScript */
    "target": "es2022",
    "lib": ["ES2022"],
    "useDefineForClassFields": true,
    "removeComments": false,

    /* Emit Types */
    "declaration": true,
    "declarationMap": false,
    "typeRoots": ["./node_modules/@types"],
    "types": ["*"],

    /* Emit Source Maps */
    "sourceMap": false, // create *.js.map files
    "inlineSources": false, // inline *.ts content in *.js.map files
    "inlineSourceMap": false // inline *.js.map content in *.js files
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./node_modules", "./dist", "./generated", "./src/codegen.ts"]
}
