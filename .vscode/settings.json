  // Turn off tsc task auto detection since we have the necessary tasks as npm scripts
  "js/ts.tsc.autoDetect": "off",
  "files.exclude": {
    "out": false,
    "dist": false
  },
  "search.exclude": {
    "out": true,
    "dist": true
  },

  "faker-js.locale": "ru",
  "faker-js.syntax": "javascript"
}
